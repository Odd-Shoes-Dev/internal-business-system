# ============================================================
# Business Management Platform - Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Database ─────────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── App Config ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SIGNUPS_ENABLED=true

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM=YourCompany <noreply@yourdomain.com>
EMAIL_REPLY_TO=support@yourdomain.com

# ── Whop (Subscription Payments) ─────────────────────────────
WHOP_API_KEY=your_whop_api_key
WHOP_COMPANY_ID=biz_your_whop_company_id
NEXT_PUBLIC_WHOP_COMPANY_ID=biz_your_whop_company_id
WHOP_SETUP_SECRET=your_whop_setup_secret

# ── File Storage (ImageKit) ──────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/...
IMAGEKIT_APP_FOLDER=internal-business-system

# ── Cron Jobs ────────────────────────────────────────────────
CRON_SECRET=your_cron_secret

# ── Support Contact (shown in app UI) ────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_DISPLAY_PHONE=+256-XXX-XXXX-XXX
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/256123456789

# ── Internal ─────────────────────────────────────────────────
APP_DB_PROVIDER=neon


# Encrypts per-company secrets at rest (e.g. WhatsApp Business tokens). 32 bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Platform administrators (who run this service for all companies), comma-separated emails.
# Required for /dashboard/admin pages and assigning legacy plans. A company's own admin role
# does not grant this.
PLATFORM_ADMIN_EMAILS=
